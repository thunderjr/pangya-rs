+/**
+ * Gives every named mutex a per-process suffix.
+ *
+ * The client refuses to run twice by creating a named mutex and checking whether it already
+ * existed. Making the name unique per process defeats that check without touching the packed
+ * executable, which cannot be patched statically in any case. Two instances on one host are only
+ * useful against a local server, where a second player is otherwise impossible to arrange.
+ *
+ * Unnamed mutexes are already per-process and pass straight through.
+ */
+static HANDLE STDCALL CreateMutexAHook(LPSECURITY_ATTRIBUTES lpMutexAttributes, BOOL bInitialOwner,
+                                       LPCSTR lpName) {
+    CHAR szUniqueName[512];
+
+    if (lpName == NULL) {
+        return pCreateMutexAOrig(lpMutexAttributes, bInitialOwner, NULL);
+    }
+    SPrintfZ(szUniqueName, "%s%s", lpName, szMutexSuffix);
+    Log("CreateMutexA(%s) -> %s\r\n", lpName, szUniqueName);
+    return pCreateMutexAOrig(lpMutexAttributes, bInitialOwner, szUniqueName);
+}
+
+/**
+ * Opens the same renamed mutex, so a lookup inside one instance still finds its own.
+ */
+static HANDLE STDCALL OpenMutexAHook(DWORD dwDesiredAccess, BOOL bInheritHandle, LPCSTR lpName) {
+    CHAR szUniqueName[512];
+
+    if (lpName == NULL) {
+        return pOpenMutexA(dwDesiredAccess, bInheritHandle, NULL);
+    }
+    SPrintfZ(szUniqueName, "%s%s", lpName, szMutexSuffix);
+    return pOpenMutexA(dwDesiredAccess, bInheritHandle, szUniqueName);
+}
+
