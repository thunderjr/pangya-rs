  "query": "SELECT r.account_id, a.username_display, r.course_id, r.mode, r.best_score, r.best_strokes, r.rounds_completed, r.first_achieved_at FROM course_records r JOIN accounts a ON a.id = r.account_id WHERE ($1::bigint IS NULL OR r.course_id = $1) ORDER BY r.best_score ASC, r.best_strokes ASC, r.first_achieved_at ASC LIMIT $2 OFFSET $3",
