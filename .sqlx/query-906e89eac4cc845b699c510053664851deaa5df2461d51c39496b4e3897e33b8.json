  "query": "SELECT m.id, m.mode, m.course_id, m.status, m.created_at, mp.strokes, mp.score, mp.place, mp.completion, mp.pang_reward, mp.experience_reward FROM match_players mp JOIN matches m ON m.id = mp.match_id WHERE mp.account_id = $1 ORDER BY m.created_at DESC LIMIT $2 OFFSET $3",
